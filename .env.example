# ---- InvenTree ---------------------------------------------------------
# InvenTree 实例的 API 地址（注意是 /api 结尾）
INVENTREE_URL=https://inventree.example.com
# 认证 Token：通过 POST /api/user/me/token/ 用 Basic Auth 取得
# 也可以用 INVENTREE_USERNAME / INVENTREE_PASSWORD 代替（不推荐长期使用）
INVENTREE_TOKEN=
# INVENTREE_USERNAME=
# INVENTREE_PASSWORD=

# 供应商名（统一固定为 LCSC；可改名但需同步 config/lcsc_categories.yaml）
INVENTREE_SUPPLIER_NAME=LCSC Electronics

# YAML 配置目录（Docker 部署时指向镜像内 /opt/lcsc2inventree/config）
# LCSC_CONFIG_DIR=

# ---- LCSC --------------------------------------------------------------
# 是否使用文件缓存（避免重复抓取触发限流）
LCSC_CACHE_ENABLED=true
LCSC_CACHE_DIR=~/.cache/lcsc2inventree
LCSC_CACHE_TTL_DAYS=7

# 速率限制：每次请求之间的最小间隔（秒）
LCSC_REQUEST_INTERVAL=1.0
# 失败重试次数
LCSC_MAX_RETRIES=3

# User-Agent（避免被风控）
LCSC_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36

# ---- 运行行为 ----------------------------------------------------------
# 分类匹配的模糊兜底阈值（0-100，建议 70-85）
CATEGORY_MATCH_RATIO_LIMIT=75
# 默认是否 dry-run（不写 InvenTree）
DRY_RUN=false

# ---- 图片上传 ----------------------------------------------------------
# 是否把 LCSC 商品图（image_urls[0]）上传到 InvenTree Part.image
# 跳过规则：Part 已有图片则跳过；--update / --update=true 强制重传
# 缓存位置：<lcsc_cache_dir>/images/<C-code>.jpg 复用相同 TTL/重试
LCSC_UPLOAD_IMAGE=true

# ---- 抓取完成后打开浏览器 ------------------------------------------------
# 抓取完成后是否自动在浏览器中打开新建 Part 的详情页
LCSC_OPEN_BROWSER=false

# ---- InvenTree 数据库一键备份 ---------------------------------------------
# 依赖：宿主机 InvenTree 也是 Docker 部署；容器需挂载 /var/run/docker.sock
#（本仓库 docker-compose.yml 已配置挂载）。备份经 docker exec 进入 InvenTree
# 容器执行原生备份，dump 全库（含条码/二维码绑定表 barcode_barcode）+ media，
# 产物落到本容器 /backup（已映射到宿主机 ./backup），UI 里「备份」页可一键执行/下载。
# 必填：InvenTree 容器名（可用 `docker ps` 查看）
INVENTREE_BACKUP_CONTAINER=
# 容器内备份命令（默认全库+media；也可设为 python manage.py dbbackup 等）
# INVENTREE_BACKUP_CMD=invoke backup
# InvenTree 容器内备份产物目录（默认值对应官方 Docker 数据卷布局）
# INVENTREE_BACKUP_SRC_DIR=/home/inventree/data/backup
# 本容器对外暴露的备份目录（默认 /backup，已被 docker-compose bind-mount 到宿主机 ./backup）
# INVENTREE_BACKUP_STORAGE=/backup